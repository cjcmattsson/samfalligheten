{
  "name": "samfalligheten",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-samfalligheten",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --dir src --passWithNoTests",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-samfalligheten \"vitest run --dir tests/rules\"",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "seed": "node functions/scripts/create-admin.mjs admin@example.com \"Test Admin\"",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-samfalligheten \"vitest run --dir tests/functions\""
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.35.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
